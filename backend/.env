# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./reviewer.db

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_CODE_LENGTH=50000
