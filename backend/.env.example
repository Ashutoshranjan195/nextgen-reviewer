# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./reviewer.db

# ── JWT Authentication ────────────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret in production!
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Ollama LLM ────────────────────────────────────────────────────────────────
# Local: http://localhost:11434  |  Docker: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_CODE_LENGTH=50000
